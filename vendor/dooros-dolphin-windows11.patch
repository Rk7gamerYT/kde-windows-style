+// Windows 11 caption button: thin vector glyphs, red close hover.
+class DoorOsCaptionButton final : public QToolButton {
+public:
+    enum Kind { Minimize, Maximize, Close, NewTab };
+    DoorOsCaptionButton(Kind kind, const QString &label, QWidget *parent) : QToolButton(parent), m_kind(kind) {
+        setToolTip(label); setAccessibleName(label); setAutoRaise(true); setCursor(Qt::ArrowCursor);
+        setFixedSize(kind == NewTab ? QSize(32, 32) : QSize(46, 40));
+    }
+protected:
+    void paintEvent(QPaintEvent *) override {
+        QPainter p(this);
+        p.setRenderHint(QPainter::Antialiasing);
+        const bool dark = palette().color(QPalette::Window).lightness() < 128;
+        QColor glyph = palette().color(QPalette::WindowText);
+        if (m_kind == NewTab) {
+            if (underMouse()) {
+                p.setPen(Qt::NoPen);
+                p.setBrush(dark ? QColor(255, 255, 255, isDown() ? 12 : 20) : QColor(0, 0, 0, isDown() ? 9 : 15));
+                p.drawRoundedRect(QRectF(rect()).adjusted(2, 2, -2, -2), 5, 5);
+            }
+        } else if (underMouse()) {
+            const QColor hover = m_kind == Close ? QColor(isDown() ? 0xc8 : 0xc4, isDown() ? 0x40 : 0x2b, isDown() ? 0x31 : 0x1c)
+                                                 : (dark ? QColor(255, 255, 255, isDown() ? 11 : 18) : QColor(0, 0, 0, isDown() ? 8 : 14));
+            p.fillRect(rect(), hover);
+            if (m_kind == Close) glyph = Qt::white;
+        }
+        p.setPen(QPen(glyph, 1.0));
+        p.setBrush(Qt::NoBrush);
+        const QPointF c = QRectF(rect()).center();
+        switch (m_kind) {
+        case Minimize: p.drawLine(QPointF(c.x()-5, c.y()+0.5), QPointF(c.x()+5, c.y()+0.5)); break;
+        case Maximize:
+            if (window()->isMaximized()) {
+                p.drawRoundedRect(QRectF(c.x()-5, c.y()-3, 8, 8), 1.5, 1.5);
+                QPainterPath back;
+                back.moveTo(c.x()-3, c.y()-5); back.lineTo(c.x()+3.5, c.y()-5);
+                back.quadTo(c.x()+5, c.y()-5, c.x()+5, c.y()-3.5); back.lineTo(c.x()+5, c.y()+3);
+                p.drawPath(back);
+            } else p.drawRoundedRect(QRectF(c.x()-5, c.y()-5, 10, 10), 1.5, 1.5);
+            break;
+        case Close:
+            p.drawLine(QPointF(c.x()-5, c.y()-5), QPointF(c.x()+5, c.y()+5));
+            p.drawLine(QPointF(c.x()+5, c.y()-5), QPointF(c.x()-5, c.y()+5));
+            break;
+        case NewTab:
+            p.drawLine(QPointF(c.x()-5.5, c.y()), QPointF(c.x()+5.5, c.y()));
+            p.drawLine(QPointF(c.x(), c.y()-5.5), QPointF(c.x(), c.y()+5.5));
+            break;
+        }
+    }
+    void enterEvent(QEnterEvent *event) override { update(); QToolButton::enterEvent(event); }
+    void leaveEvent(QEvent *event) override { update(); QToolButton::leaveEvent(event); }
+private:
+    Kind m_kind;
+};
